response←{{ operation_id }} argsNs;headerParams;queryParams;body;hasBody;clientArgs;secSchemes
⍝ {{ method | string.upcase }} {{ path }}
{{~ if summary ~}}
{{ comment_lines summary }}
{{~ end ~}}
{{~ if description ~}}
{{ comment_lines description }}
{{~ end ~}}
{{~ if parameters.size > 0 ~}}
⍝
⍝ Parameters:
{{~ for param in parameters ~}}
⍝   - {{ apl_name param.name }} (in: {{ param.in | string.downcase }}) [{{ if param.required }}required{{ else }}optional{{ end }}]{{ if param.schema.type }}: {{ param.schema.type }}{{ end }}
{{~ end ~}}
{{~ end ~}}
{{~ if request_content_type == "application/json" && request_body_arg_name ~}}
⍝
⍝ Request Body:
⍝   - {{ request_body_arg_name }} ({{ request_content_type }}){{ if request_json_body_type }}: {{ if request_body_is_array }}array of {{ end }}{{ request_json_body_type }}{{ end }}{{ if request_body.required }} (required){{ end }}
{{~ end ~}}
{{~ if request_content_type == "application/octet-stream" ~}}
⍝
⍝ Request Body:
⍝   - application/octet-stream: Binary data{{ if request_body.required }} (required){{ end }}
{{~ end ~}}
{{~ if request_content_type == "multipart/form-data" ~}}
⍝
⍝ Request Body:
⍝   - multipart/form-data{{ if request_body.required }} (required){{ end }}
{{~ if form_fields.size > 0 ~}}
⍝     Form fields:
{{~ for field in form_fields ~}}
⍝       - {{ field.dyalog_name }} ({{ field.type }}){{ if field.is_required }} [required]{{ end }}
{{~ if field.description ~}}
{{ comment_lines field.description }}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ if request_content_type && request_content_type != "application/json" && request_content_type != "application/octet-stream" && request_content_type != "multipart/form-data" ~}}
⍝
⍝ Request Body:
⍝   - {{ request_content_type }}: Generic data{{ if request_body.required }} (required){{ end }}
{{~ end ~}}
{{~ if responses.size > 0 ~}}
⍝
⍝ Returns:
{{~ for response_item in responses ~}}
⍝   - {{ response_item.key }}: {{ response_item.value.description }}
{{~ end ~}}
{{~ end ~}}
headerParams←⍬
queryParams←()
body←()
hasBody←0 ⍝ whether there is a request body to send: an optional one may be left out

{{~ # Parameters are read from argsNs under their APL names (apl_name), which differ from
    # the API name only when that is not a valid APL identifier (e.g. X-Trace → ⍙X⍙45⍙Trace). ~}}
{{~ for param in parameters ~}}
{{~ name = apl_name param.name ~}}
{{~ if param.in == "Query" ~}}
⍝ Query parameter: {{ param.name }}
:If (2=argsNs.⎕NC'{{ name }}')
{{~ if (is_array param.schema) && !param.explode ~}}
    queryParams.{{ name }}←'{{ if param.style == "SpaceDelimited" }} {{ else if param.style == "PipeDelimited" }}|{{ else }},{{ end }}'c.∆.utils.joinArray argsNs.{{ name }} ⍝ explode: false
{{~ else ~}}
    queryParams.{{ name }}←argsNs.{{ name }}
{{~ end ~}}
:{{ if param.required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: {{ name }}')
:{{ end }}EndIf
{{~ end ~}}
{{~ if param.in == "Header" ~}}
⍝ Header parameter: {{ param.name }}
:If (2=argsNs.⎕NC'{{ name }}')
    headerParams,←'{{ param.name }}' argsNs.{{ name }}
:{{ if param.required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: {{ name }}')
:{{ end }}EndIf
{{~ end ~}}
{{~ if param.in == "Path" ~}}
⍝ Path parameter: {{ param.name }}
:If 2≠argsNs.⎕NC'{{ name }}'
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: {{ name }}')
:EndIf
:If ~c.∆.utils.isValidPathParam argsNs.{{ name }}
    ⎕SIGNAL⊂('EN' 11)('Message' 'Invalid parameter: {{ name }} (must be a character vector or scalar number)')
:EndIf
:If 2|⎕DR argsNs.{{ name }} ⍝ If numeric, convert to string
    argsNs.{{ name }}←c.∆.utils.toText argsNs.{{ name }}
:EndIf
{{~ end ~}}
{{~ end ~}}

{{~ if request_content_type == "application/json" && request_body_arg_name ~}}
{{~ if request_json_body_type ~}}
⍝ Request body (JSON): a namespace or a models.{{ request_json_body_type }} instance{{ if request_body_is_array }}, or a vector of them{{ end }}
{{~ else ~}}
⍝ Request body (JSON), sent as given
{{~ end ~}}
:If (0≠argsNs.⎕NC'{{ request_body_arg_name }}')
    body←{{ if request_body_is_array }},{{ end }}c.∆.utils.formatBody argsNs.{{ request_body_arg_name }}{{ if request_body_is_array }} ⍝ a JSON array, even of one item{{ end }}
    hasBody←1
:{{ if request_body.required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: {{ request_body_arg_name }}')
:{{ end }}EndIf
{{~ end ~}}
{{~ if request_content_type == "application/octet-stream" ~}}
⍝ Request body (octet-stream)
:If (0≠argsNs.⎕NC'body')
    body←argsNs.body
    hasBody←1
:{{ if request_body.required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: body')
:{{ end }}EndIf
{{~ end ~}}
{{~ if request_content_type == "multipart/form-data" ~}}
⍝ Request body (multipart/form-data)
{{~ for field in form_fields ~}}
{{~ if field.is_binary ~}}
⍝ Binary field: {{ field.api_name }}
{{~ else ~}}
⍝ Form field: {{ field.api_name }}
{{~ end ~}}
{{~ if field.description ~}}
{{ comment_lines field.description }}
{{~ end ~}}
{{~ if (apl_name field.api_name) == field.api_name ~}}
:If (0≠argsNs.⎕NC'{{ field.dyalog_name }}')
    body.{{ field.api_name }}←argsNs.{{ field.dyalog_name }}
    hasBody←1
{{~ else ~}}
⍝ HttpCommand sends each form field under its APL name, so cannot send this one
:If (0≠argsNs.⎕NC'{{ field.dyalog_name }}')
    ⎕SIGNAL⊂('EN' 11)('Message' 'Form field {{ field.api_name }} cannot be sent, as its name is not a valid APL name')
{{~ end ~}}
:{{ if field.is_required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required form field: {{ field.dyalog_name }}')
:{{ end }}EndIf
{{~ end ~}}
{{~ end ~}}
{{~ if request_content_type && request_content_type != "application/json" && request_content_type != "application/octet-stream" && request_content_type != "multipart/form-data" ~}}
⍝ Request body ({{ request_content_type }})
:If (0≠argsNs.⎕NC'data')
    body←argsNs.data
    hasBody←1
:{{ if request_body.required }}Else
    ⎕SIGNAL⊂('EN' 11)('Message' 'Missing required parameter: data')
:{{ end }}EndIf
{{~ end ~}}

⍝ Build clientArgs
clientArgs←( ⍝ Basically HttpCommand args in a nutshell
    Command: '{{ method }}'
    URL: ({{ dyalog_path }} ⋄ ())
    Headers: headerParams
)
{{~ if request_body ~}}
{{~ if request_body.required ~}}
hasBody←1 ⍝ a required body is always sent, even if none of its fields were given
{{~ end ~}}
:If hasBody ⍝ no body, and no Content-Type, if an optional body was left out
    clientArgs.Params←body
    clientArgs.ContentType←'{{ request_content_type ?? "application/json" }}'
:EndIf
{{~ end ~}}

{{~ if has_security ~}}
secSchemes←⍬
{{~ for scheme in security_scheme_names ~}}
secSchemes,←⊂'{{ scheme }}'
{{~ end ~}}
⍝ Auth fn
clientArgs←clientArgs c.∆.utils.Authenticate secSchemes
{{~ end ~}}

queryParams←queryParams ⎕NS 2⊃clientArgs.URL
clientArgs.URL←⊃clientArgs.URL
:If 0≠⍴queryParams.⎕NL-⍳9
    clientArgs.URL,←'?',c.∆.utils.encodeQuery queryParams
:EndIf

⍝ Run and handle response
response←c.∆.utils.request clientArgs