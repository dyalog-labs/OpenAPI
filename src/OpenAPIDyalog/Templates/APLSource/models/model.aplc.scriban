:Class {{ class_name }}
{{~ if description ~}}
{{ comment_lines description }}
{{~ end ~}}
{{~ if is_map_type ~}}
    ⍝ Map type — accepts any key/value pairs
    {{~ if map_value_type ~}}
    ⍝ additionalProperties: {{ map_value_type }}
    {{~ end ~}}

    :field _data

    ∇ make1 args
        :Access public
        :Implements constructor
        _data←args
    ∇

    ∇ build←FormatNS
        :Access public
        build←_data
    ∇
{{~ else ~}}
{{~ for prop in properties ~}}
    ⍝ {{ prop.api_name }}: {{ prop.type }}{{ if prop.format }} ({{ prop.format }}){{ end }}{{ if prop.is_read_only }} [readOnly]{{ else if prop.is_write_only }} [writeOnly]{{ end }}{{ if prop.is_nullable }} [nullable]{{ end }}{{ if prop.is_required }}, required{{ else }}, optional{{ end }}{{ if prop.has_enum_values }}, enum: [{{ for v in prop.enum_values }}{{ v.api_value }}{{ if !for.last }}, {{ end }}{{ end }}]{{ end }}{{ if prop.default_value }}, default: {{ prop.default_value }}{{ end }}{{ if prop.is_reference }}, REFERENCE{{ end }}
{{~ end ~}}
{{~ if has_enums ~}}

    ⍝ Enum constants
    {{~ for prop in enum_properties ~}}
    :field public shared Enum{{ prop.enum_field_name }}
    {{~ end ~}}
{{~ end ~}}

{{~ for prop in properties ~}}
    :Property {{ prop.dyalog_name }}
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_{{ prop.dyalog_name }}' (⊂'null')
        ∇
    {{~ if !prop.is_read_only ~}}
        ∇ Set args
        {{~ if prop.has_enum_values ~}}
            :If ~args.NewValue⊂⍛∊⊃¨↓¯1↑[2]↑(⎕VGET∘¯2)Enum{{ prop.enum_field_name }}
                ⎕SIGNAL ⊂('EN' 11)('Message' ('{{ prop.dyalog_name }} must be one of:',⊃¨↓¯1↑[2]↑(⎕VGET∘¯2)Enum{{ prop.enum_field_name }}))
            :EndIf
        {{~ end ~}}
            _{{ prop.dyalog_name }}←args.NewValue
        ∇
    {{~ end ~}}
    :EndProperty

{{~ end ~}}
    ∇ make0
        :Access public
        :Implements constructor
    ∇

    ∇ make1 args
        :Access public
        :Implements constructor
        {{~ if has_writable_required_fields ~}}
        ⍝ Validate required fields (readOnly fields are server-generated, not required from caller)
        missing←{{ for f in writable_required_fields }}'{{ f }}'{{ if !for.last }} {{ end }}{{ end }}~args.⎕NL ¯2
        :If 0<⍴missing
            ⎕SIGNAL ⊂('EN' 11)('Message'('Missing required fields: ',1↓∊(⊂', '),¨missing))
        :EndIf
        {{~ end ~}}
        ⍝ Set properties through their setters
        {{~ for prop in properties ~}}
        {{~ if !prop.is_read_only ~}}
        :If 2=args.⎕NC '{{ prop.dyalog_name }}' ⋄ {{ prop.dyalog_name }}←args.{{ prop.dyalog_name }} ⋄ :EndIf
        {{~ end ~}}
        {{~ end ~}}
    ∇

    ∇ build←FormatNS
        :Access public
        build←⎕NS ''
        {{~ for prop in properties ~}}
        :If 2=⎕NC '_{{ prop.dyalog_name }}'
            {{~ if prop.is_reference && prop.is_array ~}}
            :If 0∊⍴{{ prop.dyalog_name }}
                build.{{ prop.dyalog_name }}←⍬
            :Else
                build.{{ prop.dyalog_name }}←1∘/{{ prop.dyalog_name }}.FormatNS
            :EndIf
            {{~ else if prop.is_reference ~}}
            build.{{ prop.dyalog_name }}←{{ prop.dyalog_name }}.FormatNS
            {{~ else if prop.is_array ~}}
            build.{{ prop.dyalog_name }}←1∘/⊆{{ prop.dyalog_name }}
            {{~ else ~}}
            build.{{ prop.dyalog_name }}←{{ prop.dyalog_name }}
            {{~ end ~}}
        :EndIf
        {{~ end ~}}
    ∇

    ∇ inst←FromResponse ns
        :Access public
        inst←⎕THIS
        {{~ for prop in properties ~}}
        {{~ if prop.is_reference && prop.is_array ~}}
        :If 2=ns.⎕NC '{{ prop.dyalog_name }}'
            :If 0∊⍴ns.{{ prop.dyalog_name }}
                inst._{{ prop.dyalog_name }}←⍬
            :Else
                inst._{{ prop.dyalog_name }}←{(⎕NEW (⊃⊃⎕CLASS ⎕THIS).##.{{ prop.reference_type }}).FromResponse ⍵}¨ns.{{ prop.dyalog_name }}
            :EndIf
        :EndIf
        {{~ else if prop.is_reference ~}}
        :If 9=ns.⎕NC '{{ prop.dyalog_name }}' ⋄ inst._{{ prop.dyalog_name }}←(⎕NEW (⊃⊃⎕CLASS ⎕THIS).##.{{ prop.reference_type }}).FromResponse ns.{{ prop.dyalog_name }} ⋄ :EndIf
        {{~ else ~}}
        :If 0<ns.⎕NC '{{ prop.dyalog_name }}' ⋄ inst._{{ prop.dyalog_name }}←ns.{{ prop.dyalog_name }} ⋄ :EndIf
        {{~ end ~}}
        {{~ end ~}}
    ∇
{{~ if has_enums ~}}

    ⍝ Enum constant initialization
    {{~ for prop in enum_properties ~}}
    Enum{{ prop.enum_field_name }}←(
    {{~ for v in prop.enum_values ~}}
        {{ v.apl_name }}: '{{ v.api_value }}'
    {{~ end ~}}
    )
    {{~ end ~}}
{{~ end ~}}
{{~ end ~}}
:EndClass
