{{~ end ~}}
{{~ end ~}}
{{~ for param in op.other_parameters ~}}
{{~ if param.required ~}}
    {{ param.apl_name }}: {{ param.example_value }}  ⍝ {{ param.type }}{{~ if param.description }} — {{ param.description }}{{~ end }}
{{~ else ~}}
    ⍝ {{ param.apl_name }}: {{ param.example_value }}  ⍝ {{ param.type }}{{~ if param.description }} — {{ param.description }}{{~ end }} (optional)
{{~ end ~}}
{{~ end ~}}
{{~ if op.has_request_body ~}}
{{~ if op.request_content_type == "application/json" ~}}
{{~ # Recursive field renderer.
    # pad      = leading whitespace for each line at this nesting level.
    # For optional model/array fields the pad already contains "⍝ " prefixes
    # inherited from outer optional contexts, so every inner line is automatically
    # commented without any extra branching. ~}}
{{~ func render_fields(fields, pad)
    result = ""
    for field in fields
        # Build annotation: type [+ enum values] [+ description] [+ default]
        ann = field.type
        if field.enum_values && field.enum_values.size > 0
            ann = ann + " Enum[" + (field.enum_values | array.join ", ") + "]"
        end
        if field.description
            ann = ann + " — " + field.description
        end
        if field.default_value
            ann = ann + " (default: " + field.default_value + ")"
        end
        # Snapshot ann before recursing so a recursive call cannot clobber it.
        field_ann = ann

        if field.is_read_only
            result = result + pad + "⍝ " + field.name + ": ...  ⍝ " + field.type + " (readOnly — set by server)\n"

        else if field.is_model_ref || field.is_array_of_models
            # Required fields use plain indentation; optional fields embed "⍝ " so
            # every generated line (including recursive children) is commented out.
            line_pad  = field.is_required ? pad : (pad + "⍝ ")
            inner_pad = field.is_required ? (pad + "    ") : (pad + "⍝     ")
            suffix    = "  ⍝ " + field_ann + (field.is_required ? "" : " (optional)")

            if field.is_model_ref
                open  = field.name + ": ⎕NEW models." + field.model_ref_name + " ("
                close = ")"
            else
                open  = field.name + ": (⎕NEW models." + field.array_item_model_name + " ("
                close = "))"
            end

            if field.nested_fields && field.nested_fields.size > 0
                nested = render_fields field.nested_fields inner_pad
                result = result + line_pad + open + "\n" + nested + line_pad + close + suffix + "\n"
            else
                # Nested schema could not be resolved — emit a compact placeholder.
                result = result + line_pad + open + "...)" + suffix + "\n"
            end

        else if field.is_required
            result = result + pad + field.name + ": " + field.example_value + "  ⍝ " + ann + "\n"
        else
            result = result + pad + "⍝ " + field.name + ": " + field.example_value + "  ⍝ " + ann + " (optional)\n"
        end
    end
    ret result
end ~}}
{{~ if op.request_body_model_name ~}}
