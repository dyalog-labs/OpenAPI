    body: (
{{~ if op.request_body_fields && op.request_body_fields.size > 0 ~}}
{{ render_fields op.request_body_fields "        " -}}
{{~ else ~}}
        ⍝ (no schema details available — see endpoint source)
{{~ end ~}}
    )
{{~ end ~}}
{{~ else if op.request_content_type == "multipart/form-data" ~}}
{{~ for field in op.form_fields ~}}
{{~ form_ann = field.type ~}}
{{~ if field.description ~}}{{~ form_ann = form_ann + " — " + field.description ~}}{{~ end ~}}
{{~ form_val = field.is_binary ? "'@/path/to/file'" : "'value'" ~}}
{{~ if field.is_binary ~}}{{~ form_ann = form_ann + " (see: Multipart form fields)" ~}}{{~ end ~}}
{{~ if field.is_required ~}}
    {{ field.dyalog_name }}: {{ form_val }}  ⍝ {{ form_ann }}
{{~ else ~}}
    ⍝ {{ field.dyalog_name }}: {{ form_val }}  ⍝ {{ form_ann }} (optional)
{{~ end ~}}
{{~ end ~}}
{{~ else if op.request_content_type == "application/octet-stream" ~}}
    body: 'data'  ⍝ binary
{{~ else ~}}
    data: 'data'  ⍝ {{ op.request_content_type ?? "body" }}
{{~ end ~}}
{{~ end ~}}
)

⍝ Make the request
response ← client.{{ op.apl_tag }}.{{ op.apl_name }} args
{{~ else ~}}
⍝ Make the request (no parameters required)
response ← client.{{ op.apl_tag }}.{{ op.apl_name }} ()
{{~ end ~}}
